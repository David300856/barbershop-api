{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
  "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["node"],

    "sourceMap": true,

    "strict": true,

    "skipLibCheck": true
  }
}
